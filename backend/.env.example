# Copy this file to .env and fill in real values
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Email (used by the contact form).
# Leave EMAIL_BACKEND as the console backend to just print emails to the
# terminal during development. Switch to the smtp backend to actually send.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# For Gmail, use an App Password (not your normal password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
CONTACT_RECEIVER_EMAIL=your-email@gmail.com
